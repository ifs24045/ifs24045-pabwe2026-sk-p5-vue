{
  "headers": [
  {
    "source": "/assets/(.*)",
    "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
  }
],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://open-api.delcom.org/api/v1/:path*"
    },
    {
      "source": "/img/:path*",
      "destination": "https://open-api.delcom.org/img/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}